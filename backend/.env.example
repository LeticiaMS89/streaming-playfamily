# ==========================================
# ARQUIVO DE EXEMPLO: Variáveis de Ambiente
# ==========================================
# ⚠️ IMPORTANTE: Renomeie este arquivo para .env localmente.
# Nunca comite o arquivo .env contendo valores reais no GitHub!

# --- Configurações do Servidor ---
PORT=4000
NODE_ENV=development

# --- Segurança / JWT ---
# Dica: Para gerar uma chave segura no Node.js, rode no terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cole_sua_chave_gerada_aqui

# --- CORS / Frontend ---
# URL da sua aplicação Front-end (ex: React/Vite rodando localmente)
CLIENT_URL=http://localhost:5173

# --- Banco de Dados (Exemplo) ---
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=sua_senha_aqui
# DB_NAME=nome_do_banco
# ou usando URL de conexão (Firebase/Postgres/MySQL)
# DATABASE_URL=sua_url_de_conexao_aqui
